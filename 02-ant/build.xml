<project name="GreeterCLI" default="dist" basedir=".">

  <property name="src" location="src"/>
  <property name="build" location="build"/>
  <property name="dist" location="dist"/>

  <target name="compile">
    <mkdir dir="${build}"/>
    <javac srcdir="${src}" destdir="${build}" includeantruntime="false"/>
  </target>

  <target name="dist" depends="compile">
    <mkdir dir="${dist}"/>
    <jar destfile="${dist}/greeter.jar" basedir="${build}">
      <manifest>
        <attribute name="Main-Class" value="com.acme.GreeterCLI"/>
      </manifest>
    </jar>
  </target>

</project>
